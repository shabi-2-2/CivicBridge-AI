# CivicBridge AI backend configuration
# Copy to .env and adjust as needed. Never commit .env.

APP_ENV=development

# Comma-separated list of allowed browser origins. Wildcards are rejected.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required for POST /api/v1/analyze. The key stays on the server and is never
# sent to the browser. Leave empty and the analysis endpoint returns a safe
# GEMINI_NOT_CONFIGURED error instead of fabricating a result.
GEMINI_API_KEY=

# Gemini model used for structured extraction. gemini-3.6-flash is the model
# verified here; gemini-3.8-flash can be used if your key has access.
GEMINI_MODEL=gemini-3.6-flash

# Optional display label. Defaults to civic-analysis-v1 when empty.
PROMPT_VERSION=

# Per-attempt Gemini request timeout in seconds (1-60).
GEMINI_TIMEOUT_SECONDS=15

# Retained for the health contract. No demo fixtures are served in Phase 2.
DEMO_MODE=true
