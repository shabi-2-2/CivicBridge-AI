# CivicBridge AI backend configuration
# Copy to .env and adjust as needed. Never commit .env.

APP_ENV=development

# Comma-separated list of allowed browser origins. Wildcards are rejected.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Display metadata only in Phase 1. Leave empty so /health reports null values.
# Phase 2 only: the key stays server-side and is never sent to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=
PROMPT_VERSION=

# Demo mode serves sanitised/cached fixtures when available. No fixtures exist in Phase 1.
DEMO_MODE=true
